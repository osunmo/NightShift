# Model provider (set one key; NIGHTSHIFT_PROVIDER is optional)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# NIGHTSHIFT_PROVIDER=anthropic
# NIGHTSHIFT_MODEL=claude-sonnet-5-5

# Private GitHub App for repository access, branch pushes, and PR publishing
# NIGHTSHIFT_GITHUB_APP_SLUG=your-nightshift-app
# NIGHTSHIFT_GITHUB_APP_ID=123456
# NIGHTSHIFT_GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/github-app.pem

# Optional fallback GitHub token for branch pushes and PRs (repo scope)
GITHUB_TOKEN=
# NIGHTSHIFT_DRY_RUN_PR=1

# Sandbox: local (default), docker or kubernetes. Check with: npm run cli -- doctor
NIGHTSHIFT_SANDBOX=local
# NIGHTSHIFT_DOCKER_IMAGE=node:22-bookworm
# NIGHTSHIFT_DOCKER_NETWORK=bridge   # or none
# NIGHTSHIFT_DOCKER_MEMORY=4g
# NIGHTSHIFT_DOCKER_CPUS=2
# NIGHTSHIFT_DOCKER_BIN=docker       # e.g. "sudo docker"
# NIGHTSHIFT_DOCKER_RUNTIME=runsc     # gVisor, or kata: each container gets its own kernel

# Kubernetes (see deploy/oracle/README.md)
# NIGHTSHIFT_KUBECTL=kubectl
# NIGHTSHIFT_K8S_NAMESPACE=nightshift
# NIGHTSHIFT_K8S_RUNTIME_CLASS=kata   # Kata Containers: every attempt in a QEMU microVM
# NIGHTSHIFT_K8S_IMAGE=node:22-bookworm
# NIGHTSHIFT_K8S_CPU=2
# NIGHTSHIFT_K8S_MEMORY=4Gi
# NIGHTSHIFT_K8S_NETWORK=bridge      # or none
# NIGHTSHIFT_K8S_VOLUME=hostPath     # or pvc:<claim> for multi-node

# Server
NIGHTSHIFT_PORT=4100
# NIGHTSHIFT_HOST=127.0.0.1          # 0.0.0.0 to listen on the network (set NIGHTSHIFT_API_TOKEN too)
# NIGHTSHIFT_HOME=~/.nightshift      # database, workspaces, dependency cache
# NIGHTSHIFT_MAX_TASKS=2             # tasks running at the same time
# NIGHTSHIFT_API_TOKEN=              # require a bearer token for the API

# Local models with Ollama (no API key, no cost): needs a model with tool calling and a long context.
#   ollama pull qwen2.5-coder:7b      and start Ollama with OLLAMA_CONTEXT_LENGTH=32768
# NIGHTSHIFT_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# NIGHTSHIFT_MODEL=qwen2.5-coder:7b
# Ollama Cloud instead of local: key from ollama.com/settings/keys
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_API_KEY=
# NIGHTSHIFT_LLM_CONCURRENCY=1        # the free plan allows one request at a time

# Longest reply per model call (default 8192). Lower it to make each call cheaper.
# NIGHTSHIFT_MAX_TOKENS=8192
