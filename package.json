{
  "name": "nightshift",
  "version": "0.1.0",
  "description": "Background coding agent: an orchestrator runs parallel coder agents, a QA agent and a debugging agent, then opens a reviewed pull request.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "nightshift": "./bin/nightshift.js"
  },
  "scripts": {
    "dev": "node --no-warnings --import tsx src/cli.ts serve",
    "start": "node --no-warnings --import tsx src/cli.ts serve",
    "cli": "node --no-warnings --import tsx src/cli.ts",
    "eval": "node --no-warnings --import tsx src/eval/run.ts",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "demo": "npm run build:web && node --no-warnings --import tsx src/cli.ts demo",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "tsx": "^4.0.0"
  }
}
